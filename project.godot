; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Heptarchia"
config/description="Angolszasz Kiralyok - Grand Strategy"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Localization="*res://scripts/Localization.gd"
GameSettings="*res://scripts/GameSettings.gd"
DLC="*res://scripts/DLC.gd"
GameManager="*res://scripts/GameManager.gd"
Achievements="*res://scripts/Achievements.gd"
AudioManager="*res://scripts/AudioManager.gd"
SaveManager="*res://scripts/SaveManager.gd"
Net="*res://scripts/Net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=true

[gui]

theme/custom="res://assets/ui/anglo_saxon_theme.tres"

[internationalization]

locale/fallback="hu"

[rendering]

renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

; Heptarchia Launcher – önálló Godot-projekt (a játék mellett, ugyanabban a tárolóban)

config_version=5

[application]

config/name="Heptarchia Launcher"
config/description="A Heptarchia indítója: mindig a legfrissebb változatot tölti le a GitHubról."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=760
window/size/viewport_height=600
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
